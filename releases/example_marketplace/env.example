# Magento Marketplace Configuration
# This example demonstrates multi-seller marketplace functionality

# Marketplace Mode (enabled)
MARKETPLACE=true

# Primary API URL (use your marketplace-enabled Magento instance)
MAGENTO_API_URL=https://luma-demo.scandipwa.com/

# Marketplace-specific settings
ENABLE_SELLER_REGISTRATION=true
ENABLE_SELLER_DASHBOARD=true
ENABLE_PRODUCT_REVIEWS=true
ENABLE_SELLER_RATINGS=true

# Test Credentials for Demo
# Email: test@scandipwa.com
# Password: Test@123456

# Connection settings
MAGENTO_CONNECTION_TIMEOUT=30000
MAGENTO_RECEIVE_TIMEOUT=30000

# Store configuration
MAGENTO_API_KEY=your-api-key
MAGENTO_STORE_CODE=default
