# Production Configuration for App Store
# Copy to .env before building for App Store: cp env.production .env

# Production Magento API (replace with your production store)
MAGENTO_API_URL=https://your-production-store.com/

# Connection settings for production
MAGENTO_CONNECTION_TIMEOUT=30000
MAGENTO_RECEIVE_TIMEOUT=30000

# Production store configuration
MAGENTO_API_KEY=your-production-api-key
MAGENTO_STORE_CODE=default

# App Store specific settings
APP_ENV=production
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Remove or comment out demo/test URLs in production
# MAGENTO_API_URL_ALT_1=
# MAGENTO_API_URL_ALT_2=
# MAGENTO_API_URL_ALT_3=


