<?xml version="1.0"?>
<!--
/**
 * NativeMind FlutterBridge Product View Layout
 *
 * Adds JSON-LD structured data for products.
 * Does NOT replace product view template.
 *
 * @category    NativeMind
 * @package     NativeMind_FlutterBridge
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- JSON-LD structured data for product -->
        <referenceContainer name="before.body.end">
            <block class="NativeMind\FlutterBridge\Block\Head\JsonLd"
                   name="nativemind.flutterbridge.jsonld.product"
                   template="NativeMind_FlutterBridge::head/jsonld.phtml"
                   ifconfig="nativemind_flutterbridge/jsonld/enabled"
                   cacheable="true">
                <arguments>
                    <argument name="builder_type" xsi:type="string">product</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
