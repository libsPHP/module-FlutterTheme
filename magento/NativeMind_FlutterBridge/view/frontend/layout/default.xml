<?xml version="1.0"?>
<!--
/**
 * NativeMind FlutterBridge Default Layout
 *
 * Adds route metadata and app banner blocks to all pages.
 * Does NOT replace theme templates - only adds blocks.
 *
 * @category    NativeMind
 * @package     NativeMind_FlutterBridge
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Route metadata at end of body -->
        <referenceContainer name="before.body.end">
            <block class="NativeMind\FlutterBridge\Block\Head\RouteMeta"
                   name="nativemind.flutterbridge.route.meta"
                   template="NativeMind_FlutterBridge::head/route_meta.phtml"
                   ifconfig="nativemind_flutterbridge/route/enabled"
                   cacheable="true"/>
        </referenceContainer>
    </body>
</page>
