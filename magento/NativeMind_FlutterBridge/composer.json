{
    "name": "nativemind/module-flutter-bridge",
    "description": "Theme-agnostic Magento 2 module for flutter_magento integration. Adds canonical URLs, route metadata, JSON-LD, OpenGraph, App Links, and optional app banner to any Magento theme without replacing it.",
    "version": "2.0.0",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "NativeMind",
            "email": "contact@nativemind.net",
            "homepage": "https://nativemind.net"
        }
    ],
    "keywords": [
        "magento2",
        "flutter",
        "flutter-magento",
        "seo",
        "canonical",
        "app-links",
        "universal-links",
        "deep-linking",
        "json-ld",
        "opengraph",
        "mobile-app"
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0.0",
        "magento/module-store": "^101.1.0",
        "magento/module-catalog": "^104.0.0",
        "magento/module-cms": "^103.0.0"
    },
    "suggest": {
        "nativemind/flutter-magento": "Flutter application using flutter_magento package"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "NativeMind\\FlutterBridge\\": ""
        }
    },
    "extra": {
        "magento-root-dir": "../../../../../../",
        "magento-force": true,
        "map": [
            [
                "*",
                "NativeMind/FlutterBridge"
            ]
        ]
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ]
}
