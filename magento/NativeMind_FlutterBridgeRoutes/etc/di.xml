<?xml version="1.0"?>
<!--
/**
 * Dependency Injection Configuration
 *
 * @category    NativeMind
 * @package     NativeMind_FlutterBridgeRoutes
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Canonical Resolver -->
    <preference for="NativeMind\FlutterBridgeRoutes\Model\Route\CanonicalResolverInterface"
                type="NativeMind\FlutterBridgeRoutes\Model\Route\DefaultCanonicalResolver"/>

    <!-- Route Payload Builder Pool -->
    <type name="NativeMind\FlutterBridgeRoutes\Model\Route\RoutePayloadBuilderPool">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="product" xsi:type="object">NativeMind\FlutterBridgeRoutes\Model\Route\ProductRoutePayloadBuilder</item>
                <item name="category" xsi:type="object">NativeMind\FlutterBridgeRoutes\Model\Route\CategoryRoutePayloadBuilder</item>
                <item name="cms" xsi:type="object">NativeMind\FlutterBridgeRoutes\Model\Route\CmsRoutePayloadBuilder</item>
                <item name="search" xsi:type="object">NativeMind\FlutterBridgeRoutes\Model\Route\SearchRoutePayloadBuilder</item>
                <item name="simple" xsi:type="object">NativeMind\FlutterBridgeRoutes\Model\Route\SimpleRoutePayloadBuilder</item>
            </argument>
        </arguments>
    </type>

</config>
