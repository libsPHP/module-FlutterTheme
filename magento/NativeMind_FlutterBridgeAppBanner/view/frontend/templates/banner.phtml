<?php
/** @var \NativeMind\FlutterBridgeAppBanner\Block\Banner $block */
if (!$block->isEnabled()) {
    return;
}
$config = $block->getBannerConfig();
$position = $block->escapeHtmlAttr($config['position']);
$appName = $block->escapeHtml($config['appName']);
$appIcon = $block->escapeUrl($config['appIcon']);
$ctaText = $block->escapeHtml($config['ctaText']);
$dismissDuration = (int) $config['dismissDuration'];
?>
<div id="nativemind-app-banner"
     class="nativemind-app-banner nativemind-app-banner--<?= $position ?>"
     data-dismiss-duration="<?= $dismissDuration ?>"
     style="display: none;">
    <button type="button" class="nativemind-app-banner__close" aria-label="<?= $block->escapeHtmlAttr(__('Close')) ?>">
        &times;
    </button>
    <?php if ($appIcon): ?>
    <img src="<?= $appIcon ?>" alt="<?= $appName ?>" class="nativemind-app-banner__icon" width="48" height="48">
    <?php endif; ?>
    <div class="nativemind-app-banner__content">
        <span class="nativemind-app-banner__name"><?= $appName ?></span>
    </div>
    <a href="#" class="nativemind-app-banner__cta" data-android-url="<?= $block->escapeUrl($config['androidStoreUrl']) ?>" data-ios-url="<?= $block->escapeUrl($config['iosStoreUrl']) ?>">
        <?= $ctaText ?>
    </a>
</div>
<style>
.nativemind-app-banner {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.nativemind-app-banner--top { top: 0; }
.nativemind-app-banner--bottom { bottom: 0; }
.nativemind-app-banner__close {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    color: #666;
}
.nativemind-app-banner__icon {
    border-radius: 12px;
    flex-shrink: 0;
}
.nativemind-app-banner__content {
    flex: 1;
    min-width: 0;
}
.nativemind-app-banner__name {
    font-weight: 600;
    font-size: 14px;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.nativemind-app-banner__cta {
    background: #007bff;
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
}
.nativemind-app-banner__cta:hover {
    background: #0056b3;
}
@media (min-width: 768px) {
    .nativemind-app-banner { display: none !important; }
}
</style>
<script>
(function() {
    var banner = document.getElementById('nativemind-app-banner');
    if (!banner) return;

    var dismissKey = 'nativemind_app_banner_dismissed';
    var dismissDuration = parseInt(banner.dataset.dismissDuration, 10) || 7;
    var dismissed = localStorage.getItem(dismissKey);

    if (dismissed) {
        var dismissedTime = parseInt(dismissed, 10);
        var daysElapsed = (Date.now() - dismissedTime) / (1000 * 60 * 60 * 24);
        if (daysElapsed < dismissDuration) return;
    }

    var ua = navigator.userAgent || '';
    var isAndroid = /android/i.test(ua);
    var isIos = /iphone|ipad|ipod/i.test(ua);

    if (!isAndroid && !isIos) return;

    var cta = banner.querySelector('.nativemind-app-banner__cta');
    if (cta) {
        var url = isAndroid ? cta.dataset.androidUrl : cta.dataset.iosUrl;
        if (url) cta.href = url;
    }

    banner.style.display = 'flex';

    var closeBtn = banner.querySelector('.nativemind-app-banner__close');
    if (closeBtn) {
        closeBtn.addEventListener('click', function() {
            banner.style.display = 'none';
            localStorage.setItem(dismissKey, Date.now().toString());
        });
    }
})();
</script>
