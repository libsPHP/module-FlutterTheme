<?php
/**
 * App Banner Template
 *
 * @var \NativeMind\Bridge\Block\App\Banner $block
 */

if (!$block->isEnabled()) {
    return;
}

$dismissDays = $block->getDismissDays();
?>
<div class="nm-Bridge-banner"
     id="nm-Bridge-banner"
     data-dismiss-days="<?= $block->escapeHtmlAttr($dismissDays) ?>"
     style="display: none;">
    <div class="nm-Bridge-banner__content">
        <div class="nm-Bridge-banner__text">
            <strong class="nm-Bridge-banner__title">
                <?= $block->escapeHtml($block->getTitle()) ?>
            </strong>
            <span class="nm-Bridge-banner__subtitle">
                <?= $block->escapeHtml($block->getSubtitle()) ?>
            </span>
        </div>
        <div class="nm-Bridge-banner__actions">
            <a class="nm-Bridge-banner__btn nm-Bridge-banner__btn--open"
               href="<?= $block->escapeUrl($block->getCurrentUrl()) ?>"
               rel="nofollow">
                <?= $block->escapeHtml($block->getOpenButtonText()) ?>
            </a>
            <?php if ($block->getInstallUrl() !== '#'): ?>
            <a class="nm-Bridge-banner__btn nm-Bridge-banner__btn--install"
               href="<?= $block->escapeUrl($block->getInstallUrl()) ?>"
               target="_blank"
               rel="nofollow noopener">
                <?= $block->escapeHtml($block->getInstallButtonText()) ?>
            </a>
            <?php endif; ?>
        </div>
    </div>
    <button type="button"
            class="nm-Bridge-banner__close"
            id="nm-Bridge-banner-close"
            aria-label="Close">
        &times;
    </button>
</div>

<script>
(function() {
    var banner = document.getElementById('nm-Bridge-banner');
    var closeBtn = document.getElementById('nm-Bridge-banner-close');
    var cookieName = 'nm_Bridge_dismissed';
    var dismissDays = parseInt(banner.getAttribute('data-dismiss-days')) || 7;

    function getCookie(name) {
        var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? match[2] : null;
    }

    function setCookie(name, value, days) {
        var expires = '';
        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = '; expires=' + date.toUTCString();
        }
        document.cookie = name + '=' + value + expires + '; path=/';
    }

    function showBanner() {
        if (!getCookie(cookieName)) {
            banner.style.display = 'flex';
        }
    }

    function dismissBanner() {
        banner.style.display = 'none';
        setCookie(cookieName, '1', dismissDays);
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', dismissBanner);
    }

    // Show banner after page load
    if (document.readyState === 'complete') {
        showBanner();
    } else {
        window.addEventListener('load', showBanner);
    }
})();
</script>
